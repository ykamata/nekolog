{
  "name": "nuxt3-typescript-project",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:validate": "node scripts/build-validate.js",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:agent": "npx tsx scripts/vitest-agent.ts",
    "test:agent:watch": "npx tsx scripts/vitest-agent.ts -- --watch",
    "test:agent:coverage": "npx tsx scripts/vitest-agent.ts -- --coverage",
    "test:agent:verbose": "npx tsx scripts/vitest-agent.ts -- --verbose",
    "test:components": "vitest run tests/components",
    "test:performance": "vitest run tests/performance --reporter=verbose",
    "test:performance:report": "node scripts/run-performance-tests.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "db:generate": "prisma generate",
    "db:generate:mysql": "prisma generate --schema=prisma/schema.mysql.prisma",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy --schema=prisma/schema.mysql.prisma",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:studio:mysql": "prisma studio --schema=prisma/schema.mysql.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:mysql": "DATABASE_URL=mysql://ykamata:ykamata@mysql:3306/nekolog tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:rebuild": "docker-compose down && docker-compose build --no-cache && docker-compose up -d",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:app": "docker-compose logs -f app",
    "docker:logs:mysql": "docker-compose logs -f mysql",
    "docker:shell:app": "docker-compose exec app sh",
    "docker:shell:mysql": "docker-compose exec mysql mysql -u ykamata -pykamata nekolog",
    "docker:seed": "docker-compose exec app npm run db:seed",
    "docker:studio": "docker-compose exec app npm run db:studio:mysql",
    "docker:clean": "docker-compose down -v && rm -rf node_modules/.cache"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.10.0",
    "@pinia/nuxt": "^0.11.3",
    "@prisma/client": "^6.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@unocss/nuxt": "^66.5.6",
    "@vueuse/nuxt": "^14.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "chart.js": "^4.5.0",
    "jose": "^6.0.12",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.2",
    "nuxt": "^4.2.1",
    "pinia": "^3.0.4",
    "prisma": "^6.12.0",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@nuxt/test-utils": "^3.20.1",
    "@nuxtjs/tailwindcss": "^6.12.1",
    "@playwright/test": "^1.47.2",
    "@stylistic/eslint-plugin": "^2.8.0",
    "@types/node": "^22.5.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.10.0",
    "happy-dom": "^18.0.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.6.2",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
