{
  "name": "nuxt3-typescript-project",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:validate": "node scripts/build-validate.js",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:agent": "npx tsx scripts/vitest-agent.ts",
    "test:agent:watch": "npx tsx scripts/vitest-agent.ts -- --watch",
    "test:agent:coverage": "npx tsx scripts/vitest-agent.ts -- --coverage",
    "test:agent:verbose": "npx tsx scripts/vitest-agent.ts -- --verbose",
    "test:components": "vitest run tests/components",
    "test:performance": "vitest run tests/performance --reporter=verbose",
    "test:performance:report": "node scripts/run-performance-tests.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy --schema=prisma/schema.mysql.prisma",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@nuxt/eslint": "^0.5.7",
    "@pinia/nuxt": "^0.5.4",
    "@prisma/client": "^6.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@unocss/nuxt": "^0.62.4",
    "@vueuse/nuxt": "^11.1.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "chart.js": "^4.5.0",
    "jose": "^6.0.12",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.2",
    "nuxt": "^3.13.0",
    "pinia": "^2.2.2",
    "prisma": "^6.12.0",
    "vue": "latest",
    "vue-chartjs": "^5.3.2",
    "vue-router": "latest",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@nuxt/test-utils": "^3.19.2",
    "@nuxtjs/tailwindcss": "^6.12.1",
    "@playwright/test": "^1.47.2",
    "@stylistic/eslint-plugin": "^2.8.0",
    "@types/node": "^22.5.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.10.0",
    "happy-dom": "^18.0.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.6.2",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
