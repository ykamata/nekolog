// Production Prisma schema file for MySQL
// Use this schema for production deployments

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Cat {
  id        Int      @id @default(autoincrement())
  name      String
  birthdate DateTime?
  weight    Float?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals              MealRecord[]
  medicationRecords  MedicationRecord[]
  medicationSchedules MedicationSchedule[]
  medicationReminders MedicationReminder[]
  veterinaryVisits   VeterinaryVisit[]
  veterinaryAppointments VeterinaryAppointment[]
  excretionRecords   ExcretionRecord[]
  dailyNotes         DailyNote[]

  @@map("cats")
}

model Food {
  id              Int      @id @default(autoincrement())
  name            String
  type            FoodType
  brand           String?
  caloriesPerGram Float
  pricePerUnit    Float?
  unit            String   @default("g")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  meals           MealRecord[]

  @@map("foods")
}

model MealRecord {
  id        Int      @id @default(autoincrement())
  catId     Int
  foodId    Int
  quantity  Float    // in grams
  calories  Float    // calculated or manual
  mealTime  DateTime
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cat       Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@map("meal_records")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  veterinaryHospitals VeterinaryHospital[]
  veterinaryDoctors   VeterinaryDoctor[]

  @@map("users")
}

enum FoodType {
  DRY
  WET
}

model Medication {
  id          Int      @id @default(autoincrement())
  name        String
  type        MedicationType
  description String?  @db.Text
  dosage      String?  @db.Text // 投与量の説明
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records     MedicationRecord[]
  schedules   MedicationSchedule[]
  reminders   MedicationReminder[]
  dailyNotes  DailyNote[]

  @@map("medications")
}

model MedicationRecord {
  id           Int      @id @default(autoincrement())
  catId        Int
  medicationId Int
  quantity     Int      // 投与個数
  administeredAt DateTime
  status       MedicationStatus @default(PENDING)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cat          Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  @@map("medication_records")
}

model MedicationSchedule {
  id           Int      @id @default(autoincrement())
  catId        Int
  medicationId Int
  frequency    String   // "daily", "twice_daily", "weekly", etc.
  times        String   @db.Text // JSON array of times: ["08:00", "20:00"]
  startDate    DateTime
  endDate      DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cat          Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  reminders    MedicationReminder[]

  @@map("medication_schedules")
}

model MedicationReminder {
  id           Int      @id @default(autoincrement())
  scheduleId   Int
  catId        Int
  medicationId Int
  scheduledAt  DateTime
  status       ReminderStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedule     MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  cat          Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  @@map("medication_reminders")
}

enum MedicationType {
  MEDICINE
  SUPPLEMENT
  VITAMIN
}

enum MedicationStatus {
  PENDING
  ADMINISTERED
  SKIPPED
  MISSED
}

enum ReminderStatus {
  PENDING
  ACKNOWLEDGED
  SNOOZED
  DISMISSED
}

model VeterinaryVisit {
  id           Int      @id @default(autoincrement())
  catId        Int
  visitDate    DateTime
  hospitalId   Int
  doctorId     Int?
  cost         Float
  notes        String?  @db.Text
  hasBloodTest Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cat          Cat                    @relation(fields: [catId], references: [id], onDelete: Cascade)
  hospital     VeterinaryHospital     @relation(fields: [hospitalId], references: [id])
  doctor       VeterinaryDoctor?      @relation(fields: [doctorId], references: [id])
  treatments   VeterinaryVisitTreatment[]

  @@map("veterinary_visits")
}

model VeterinaryAppointment {
  id                Int               @id @default(autoincrement())
  catId             Int
  appointmentDate   DateTime
  hospitalId        Int
  doctorId          Int?
  plannedTreatments String?          @db.Text
  notes             String?          @db.Text
  status            AppointmentStatus @default(SCHEDULED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  cat      Cat                  @relation(fields: [catId], references: [id], onDelete: Cascade)
  hospital VeterinaryHospital   @relation(fields: [hospitalId], references: [id])
  doctor   VeterinaryDoctor?    @relation(fields: [doctorId], references: [id])

  @@map("veterinary_appointments")
}

model VeterinaryHospital {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  address   String?  @db.Text
  phone     String?
  memo      String?  @db.Text
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  visits       VeterinaryVisit[]
  appointments VeterinaryAppointment[]
  doctors      VeterinaryDoctor[]

  @@map("veterinary_hospitals")
}

model VeterinaryDoctor {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  hospitalId   Int?
  specialty    String? @db.Text
  memo         String? @db.Text
  userId       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital     VeterinaryHospital?     @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  visits       VeterinaryVisit[]
  appointments VeterinaryAppointment[]

  @@map("veterinary_doctors")
}

model VeterinaryTreatment {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  category    String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visitTreatments VeterinaryVisitTreatment[]

  @@map("veterinary_treatments")
}

model VeterinaryVisitTreatment {
  id          Int @id @default(autoincrement())
  visitId     Int
  treatmentId Int

  visit     VeterinaryVisit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  treatment VeterinaryTreatment @relation(fields: [treatmentId], references: [id])

  @@unique([visitId, treatmentId])
  @@map("veterinary_visit_treatments")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model ExcretionRecord {
  id         Int           @id @default(autoincrement())
  catId      Int
  type       ExcretionType
  recordedAt DateTime
  notes      String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  cat        Cat           @relation(fields: [catId], references: [id], onDelete: Cascade)

  // パフォーマンス最適化のためのインデックス
  @@index([catId])                           // 猫別フィルタリング用
  @@index([recordedAt])                      // 日付範囲検索用
  @@index([type])                            // 排泄タイプフィルタリング用
  @@index([catId, recordedAt])               // 猫別 + 日付範囲の複合検索用
  @@index([catId, type])                     // 猫別 + タイプの複合検索用
  @@index([recordedAt, type])                // 日付範囲 + タイプの複合検索用
  @@index([catId, recordedAt, type])         // 全フィルタ条件の複合検索用
  @@map("excretion_records")
}

enum ExcretionType {
  URINE  // おしっこ
  FECES  // うんち
}

model DailyNote {
  id              Int      @id @default(autoincrement())
  catId           Int
  date            DateTime // 日付（時刻は00:00:00に正規化）
  medicationId    Int?     // 頓服薬のID
  emergencyMedication Boolean @default(false) // 頓服薬の投与があったか
  memo            String?  @db.Text // 特記事項・メモ
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cat             Cat        @relation(fields: [catId], references: [id], onDelete: Cascade)
  medication      Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  // 1つの猫に対して1日1レコードのユニーク制約
  @@unique([catId, date])
  @@index([date])
  @@index([catId, date])
  @@map("daily_notes")
}
