# Production Environment Configuration
# Copy this file to .env.production and update the values

# ========================================
# Database Configuration (MySQL)
# ========================================
MYSQL_ROOT_PASSWORD=your-secure-root-password-here
MYSQL_USER=nekolog-user
MYSQL_PASSWORD=your-secure-database-password-here
MYSQL_PORT=3306
MYSQL_DATABASE="nekolog"
MYSQL_HOST=production-host-ip

# Database URL for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://nekolog:your-secure-database-password-here@mysql:3306/nekolog"

# ========================================
# Application Configuration
# ========================================
NODE_ENV=production
APP_PORT=3000

# ========================================
# Authentication & Security
# ========================================
# IMPORTANT: Generate a strong, unique secret key for JWT tokens
# Example: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters

# ========================================
# Nuxt Configuration
# ========================================
NITRO_PORT=3000
NITRO_HOST=0.0.0.0

# ========================================
# Optional: Monitoring & Logging
# ========================================
# LOG_LEVEL=info
# ENABLE_ACCESS_LOG=true

# ========================================
# Optional: Backup Configuration
# ========================================
# BACKUP_RETENTION_DAYS=30
# BACKUP_DIR=/app/backups

# ========================================
# NOTES
# ========================================
# 1. Never commit .env.production to git
# 2. Use strong, unique passwords for all credentials
# 3. Generate JWT_SECRET with: openssl rand -base64 64
# 4. Keep this file secure and restrict access permissions
# 5. Update all "your-secure-*" values before deploying
