{
  "name": "Nekolog Development",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/app",

  // Configure tool-specific properties
  "customizations": {
    "vscode": {
      // VS Code extensions to install
      "extensions": [
        "dbaeumer.vscode-eslint",
        "Vue.volar",
        "Vue.vscode-typescript-vue-plugin",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "ms-azuretools.vscode-docker"
      ],
      // VS Code settings
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "[vue]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },

  // Forward ports
  "forwardPorts": [3000, 3306, 24679],
  "portsAttributes": {
    "0-2999": { "onAutoForward": "ignore" },
    "3000": {
      "label": "Application",
      "onAutoForward": "notify"
    },
    "3001-3305": { "onAutoForward": "ignore" },
    "3306": {
      "label": "MySQL",
      "onAutoForward": "silent"
    },
    "3307-24678": { "onAutoForward": "ignore" },
    "24679": {
      "label": "HMR WebSocket",
      "onAutoForward": "silent"
    },
    "24680-65535": { "onAutoForward": "ignore" }
  },

  // Use 'postCreateCommand' to run commands after the container is created
  // Note: npm install is already done in Dockerfile, so only generate Prisma client
  "postCreateCommand": "npm run db:generate",

  // Use 'postStartCommand' to run commands after the container starts
  "postStartCommand": "echo '🐱 Nekolog development environment is ready!'",

  // Comment out to connect as root instead
  "remoteUser": "node",

  // Keep container running for debugging
  "shutdownAction": "stopCompose",

  // Features to add to the dev container
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  }
}
