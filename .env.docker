# Docker Environment Configuration for Nekolog
# This file is used when running the application in Docker Compose

# Database Configuration (MySQL)
DATABASE_URL="mysql://ykamata:ykamata@mysql:3306/nekolog"

# JWT Secret (Change this in production!)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-please-use-a-long-random-string"

# Node Environment
NODE_ENV="development"

# Application Port
PORT=3000

# MySQL Configuration (used by docker-compose.yml)
MYSQL_ROOT_PASSWORD="root"
MYSQL_DATABASE="nekolog"
MYSQL_USER="ykamata"
MYSQL_PASSWORD="ykamata"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
