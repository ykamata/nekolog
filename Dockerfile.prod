# Multi-stage build for production
# Stage 1: Build
FROM node:22-bookworm-slim AS builder

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Enable pnpm via corepack (version + hash pinned by package.json "packageManager")
RUN corepack enable

# Copy package files (pnpm-lock.yaml is required for --frozen-lockfile)
COPY package.json pnpm-lock.yaml ./

# Copy Prisma schema (needed before pnpm install for postinstall)
COPY prisma ./prisma/

# Install all dependencies (--ignore-scripts: postinstall runs prisma generate before schema is fully in place)
RUN pnpm install --frozen-lockfile --ignore-scripts

# Run nuxt prepare
RUN pnpm exec nuxt prepare

# Generate Prisma Client for MySQL
RUN pnpm exec prisma generate --schema=prisma/schema.prisma

# Copy application source
COPY . .

# Set NODE_ENV for build (required for nuxt.config.ts conditional logic)
ENV NODE_ENV=production

# Build the application
RUN pnpm run build

# Slack通知バッチスクリプトをバンドル（本番コンテナには tsx が含まれないため esbuild でコンパイル）
RUN pnpm exec esbuild scripts/slack/weekly-meal-report.ts \
      --bundle --platform=node --format=esm \
      --external:@prisma/client \
      --outfile=batch/weekly-meal-report.js
RUN pnpm exec esbuild scripts/slack/daily-memo-report.ts \
      --bundle --platform=node --format=esm \
      --external:@prisma/client \
      --outfile=batch/daily-memo-report.js

# 低カロリー見落としチェックバッチをバンドル
RUN pnpm exec esbuild scripts/batch/check-low-calorie.ts \
      --bundle --platform=node --format=esm \
      --external:@prisma/client \
      --outfile=batch/check-low-calorie.js

# Stage 2: Production
FROM node:22-bookworm-slim AS production

# Set working directory
WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    procps \
    curl \
    default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

# Enable pnpm via corepack (version + hash pinned by package.json "packageManager")
RUN corepack enable

# Copy package files (pnpm-lock.yaml is required for --frozen-lockfile)
COPY package.json pnpm-lock.yaml ./

# Copy Prisma schema
COPY prisma ./prisma/

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

# Generate Prisma Client for MySQL
RUN pnpm exec prisma generate --schema=prisma/schema.prisma

# Copy built application from builder
COPY --from=builder /app/.output /app/.output
COPY --from=builder /app/.nuxt /app/.nuxt
COPY --from=builder /app/batch /app/batch
COPY --from=builder /app/config /app/config

# Copy necessary runtime files
COPY nuxt.config.ts ./
COPY tsconfig.json ./
COPY tailwind.config.ts ./

# Create non-root user
RUN groupadd -r nekolog && useradd -r -g nekolog nekolog

# Create uploads directory in .output/public with proper permissions
# RUN mkdir -p /app/.output/public/uploads/cats && \
#     chown -R nekolog:nekolog /app/.output/public/uploads && \
#     chmod -R 2775 /app/.output/public/uploads
RUN mkdir -p /app/.output/public/uploads/cats

# Set ownership
#RUN chown -R nekolog:nekolog /app

# Switch to non-root user
#USER nekolog

# Set environment variables for runtime
ENV NODE_ENV=production
ENV PORT=3000

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://127.0.0.1:3000/api/health || exit 1

# Start application
CMD ["node", ".output/server/index.mjs"]
